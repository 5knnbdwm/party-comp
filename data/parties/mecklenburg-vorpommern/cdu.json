      "sources": [
        {
          "capture": "cap_20260917T094621521Z_5d5dba4c",
          "quote": "Heute haben der CDU-Spitzenkandidat für Mecklenburg-Vorpommern, Daniel Peters, und die Landtagskandidatin Jeannette von Busse gemeinsam mit dem...",
          "page": null
        },
        {
