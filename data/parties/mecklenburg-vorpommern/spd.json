    {
      "observed_at": "2026-09-17T09:52:45.316Z",
      "sources": [
        {
          "capture": "cap_20260917T095245316Z_941a92a8",
          "quote": "Schwesig sei offen dafür, \"mit Demokraten zu sprechen. Und ich habe in mehreren Regierungskonstellationen bewiesen, dass ich diejenige bin, die verschiedene politische Richtungen zusammenführt.\"",
          "page": null
        }
      ],
